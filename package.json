{
  "name": "good-job",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:index",
    "build:index": "tsx scripts/build-screener-index.ts",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply good-job-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply good-job-db --remote",
    "seed:local": "tsx scripts/seed.ts --local",
    "seed:remote": "tsx scripts/seed.ts --remote",
    "ingest": "tsx scripts/ingest/cli.ts",
    "lint": "tsc -b --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.7.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "wrangler": "^4.24.0"
  }
}
